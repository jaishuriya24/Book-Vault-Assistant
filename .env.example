# Book Vault Environment Configuration
# Copy this file to .env and configure your local credentials

# OpenRouter API Key for NLP Intent Classification
VITE_OPENROUTER_API_KEY="your_openrouter_api_key"

# ElevenLabs API Key for high-quality multi-lingual Text-to-Speech (Optional)
VITE_ELEVENLABS_API_KEY="your_elevenlabs_api_key"

# Gemini API Key for Multilingual Intent Parsing
GEMINI_API_KEY="your_gemini_api_key"
VITE_GEMINI_API_KEY="your_gemini_api_key"

# Backend Server URLs
VITE_SPRING_BOOT_AUTH_URL="http://localhost:8081"
VITE_SPRING_BOOT_API_URL="http://localhost:8082"

# MySQL Configuration
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="farmer"
MYSQL_PASSWORD="farmer123"
MYSQL_DB="farmo_ai_db"
DATABASE_URL="mysql+pymysql://farmer:farmer123@localhost:3306/farmo_ai_db"
