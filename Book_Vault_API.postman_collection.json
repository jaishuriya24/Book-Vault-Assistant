{
  "info": {
    "name": "Book-Vault FastAPI",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Sign Up",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "name", "value": "Test User", "type": "text" },
                { "key": "email", "value": "test@example.com", "type": "text" },
                { "key": "username", "value": "testuser", "type": "text" },
                { "key": "password", "value": "password123", "type": "text" }
              ]
            },
            "url": {
              "raw": "http://localhost:8000/api/auth/signup",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "auth", "signup"]
            }
          }
        },
        {
          "name": "2. Verify OTP",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "email", "value": "test@example.com", "type": "text" },
                { "key": "otp", "value": "1234", "type": "text" }
              ]
            },
            "url": {
              "raw": "http://localhost:8000/api/auth/verify-otp",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "auth", "verify-otp"]
            }
          }
        },
        {
          "name": "3. Sign In",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "testuser", "type": "text" },
                { "key": "password", "value": "password123", "type": "text" }
              ]
            },
            "url": {
              "raw": "http://localhost:8000/api/auth/signin",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "auth", "signin"]
            }
          }
        }
      ]
    },
    {
      "name": "Books (Requires Auth)",
      "item": [
        {
          "name": "List Books",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/api/books",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "books"]
            }
          }
        },
        {
          "name": "Create Book",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "title", "value": "My New Book", "type": "text" }
              ]
            },
            "url": {
              "raw": "http://localhost:8000/api/books",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "books"]
            }
          }
        },
        {
          "name": "Get Book",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/api/books/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "books", "1"]
            }
          }
        },
        {
          "name": "Delete Book",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/api/books/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "books", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Pages (Requires Auth)",
      "item": [
        {
          "name": "Upload Page Image",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "http://localhost:8000/api/books/1/upload-page",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "books", "1", "upload-page"]
            }
          }
        },
        {
          "name": "Get Page",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/api/books/1/pages/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "books", "1", "pages", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Voice Commands",
      "item": [
        {
          "name": "Parse Intent",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "transcription", "value": "Turn to the next page", "type": "text" }
              ]
            },
            "url": {
              "raw": "http://localhost:8000/api/intent",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "intent"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "access_token",
      "value": "PASTE_ACCESS_TOKEN_HERE"
    }
  ]
}
