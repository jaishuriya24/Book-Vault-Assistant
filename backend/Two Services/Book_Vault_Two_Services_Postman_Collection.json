{
  "info": {
    "name": "Book Vault Microservices (Auth & Book Services)",
    "description": "Postman Collection for Book Vault Application Spring Boot Auth Service (Port 8081) and Book Service (Port 8082).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth Service (Port 8081)",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Book Vault User\",\n  \"email\": \"reader@bookvault.com\",\n  \"password\": \"secret123\",\n  \"role\": \"EMPLOYEE\"\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login (Auto-Saves JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('jwt_token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"reader@bookvault.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get User Profile (/api/users/me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/users/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "users", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Book Service (Port 8082)",
      "item": [
        {
          "name": "List User Books",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8082/api/books",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "books"]
            }
          }
        },
        {
          "name": "Create Book",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Art of Computer Programming\",\n  \"language\": \"eng\",\n  \"fullText\": \"Chapter 1: Fundamental Concepts...\",\n  \"source\": \"manual\"\n}"
            },
            "url": {
              "raw": "http://localhost:8082/api/books",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "books"]
            }
          }
        },
        {
          "name": "Search Books",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8082/api/books/search?q=Computer",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "books", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "Computer"
                }
              ]
            }
          }
        },
        {
          "name": "Get Book by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8082/api/books/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "books", "1"]
            }
          }
        },
        {
          "name": "Update Book Details",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Art of Computer Programming (Vol 1)\",\n  \"language\": \"eng\",\n  \"fullText\": \"Chapter 1: Fundamental Concepts & Algorithms...\",\n  \"source\": \"manual\"\n}"
            },
            "url": {
              "raw": "http://localhost:8082/api/books/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "books", "1"]
            }
          }
        },
        {
          "name": "Update Reading Position",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lastPositionChar\": 1050\n}"
            },
            "url": {
              "raw": "http://localhost:8082/api/books/1/position",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "books", "1", "position"]
            }
          }
        },
        {
          "name": "Delete Book",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:8082/api/books/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "books", "1"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "jwt_token",
      "value": ""
    }
  ]
}
